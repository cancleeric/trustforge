__pycache__/
*.py[cod]
# 不加尾斜線：worktree 常把 .venv 做成指向主 checkout 的 symlink，
# `.venv/` 只匹配目錄，會讓那些 symlink 顯示為未追蹤。
.venv
venv
*.egg-info/
build/
dist/
.pytest_cache/
# #91 覆蓋率工具產物（addopts 一律帶 --cov）：不進版控
.coverage
.coverage.*
htmlcov/
coverage.xml
.DS_Store
.env
# 企業數據（HOYA BIT）不進版控
demo/hoyabit_data/
*.secret
# 生成的交付件輸出（可重跑）
out/
# 本機憑證檔：glob 覆蓋 coinmarketcap.apikey / etherscan.apikey / whale.alert.apikey
# 及未來任何 *.apikey（字面 ".apikey" 只匹配名為 .apikey 的檔，會漏 coinmarketcap.apikey）。
*.apikey
.eye-cache/
.claude/
.cli/
.playwright-mcp/
.kiro/settings/

# JavaScript dependency trees and tool caches are reproducible local artifacts.
/node_modules/

# 本機審查與執行期產物
semantic-review/
skills/hermes/source/*.json

# 本機憑證（正式值存放於 Hurricane Vault）
whale.alert.apikey
data/trustforge.db
