name: "Deploy Frontend"

on:
  workflow_dispatch:
    # 手動觸發 TrustForge 前端生產部署
    inputs:
      confirm:
        type: choice
        options:
          - "no"
          - "yes"
        default: "no"
        description: "確認要部署到生產環境"

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    # 避免兩個部署同時競態覆寫 S3、也避免正在跑的部署被新觸發的 workflow 取消，
    # 因為部署腳本內部有 ERR trap 回滾機制，半途被殺掉會跳過回滾邏輯，所以是排隊而非取消。
    concurrency:
      group: deploy-frontend
      cancel-in-progress: false
    # 防止 npm ci / AWS API / OIDC 卡住吃滿 GitHub Actions 預設的 360 分鐘 timeout
    timeout-minutes: 20
    permissions:
      id-token: write   # OIDC: 允許向 AWS 請求短期憑證
      contents: read
    steps:
      - name: Abort if not confirmed
        if: github.event.inputs.confirm != 'yes'
        run: |
          echo "確認參數為 'no'，中止部署。請在 workflow_dispatch 選擇 'yes' 才能繼續。"
          exit 1

      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1

      - name: Setup Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: "22"
          cache: 'npm'
          cache-dependency-path: frontend/package-lock.json

      - name: Compute short git sha
        id: gitsha
        run: |
          echo "sha=$(git rev-parse --short HEAD)" >> $GITHUB_OUTPUT
          echo "VITE_GIT_SHA=$(git rev-parse --short HEAD)" >> $GITHUB_ENV

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@7474bc4690e29a8392af63c5b98e7449536d5c3a # v4.3.1
        with:
          # 走 OIDC，不需長期 AWS access key
          role-to-assume: ${{ secrets.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ap-southeast-2

      - name: Deploy frontend
        # 複用既有部署腳本，避免在 workflow 重複實作部署邏輯
        # 部署腳本內部（非 dry-run）會重新 npm ci && npm run build，
        # 透過 $GITHUB_ENV 設定的 VITE_GIT_SHA 可自動帶入該次 build
        run: bash deploy/deploy_frontend_nginx.sh
        env:
          REGION: ap-southeast-2

      - name: Deployment done
        run: |
          echo "部署完成。git sha: ${{ steps.gitsha.outputs.sha }}"
