[Unit]
Description=TrustForge release-level A/B GET router
After=network.target trustforge-a.service trustforge-b.service
Requires=trustforge-a.service

[Service]
Type=simple
User=trustforge
Group=trustforge
WorkingDirectory=/opt/trustforge
ExecStart=/opt/trustforge/.venv/bin/python scripts/release_router_service.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trustforge/security-ledger
ReadOnlyPaths=/etc/trustforge

[Install]
WantedBy=multi-user.target
