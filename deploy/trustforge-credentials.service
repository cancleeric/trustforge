# ============================================================================
# trustforge-credentials.service  (#121.7 systemd credentials 整合 — 時序修正)
#
# 用途：
#   獨立 oneshot unit，在 trustforge.service **啟動之前**（Before=trustforge
#   .service）把 SSM Parameter Store 的 SecureString runtime token（admin-token /
#   live-token）以 0600 寫入 **tmpfs 憑證目錄** /run/trustforge-credentials，
#   檔名為 `trustforge-<name>`（如 trustforge-admin-token）。
#
# 為什麼必須是獨立 oneshot、不能用 trustforge.service 的 ExecStartPre：
#   systemd 在 `ExecStartPre` **之前**就載入 `LoadCredential=` 的來源檔。若由
#   trustforge.service 的 ExecStartPre 產生憑證檔，載入時檔案還不存在 →
#   LoadCredential 失敗 / app 讀不到 token。改由本 oneshot unit（Before=
#   trustforge.service）先把檔案寫好，trustforge.service 啟動、LoadCredential
#   載入時檔案已就緒。
#
# 對應讀取端：
#   - 寫入邏輯：deploy/setup_runtime_credentials.sh（本 unit 的 ExecStart）。
#   - 讀取邏輯：src/trustforge/ssm_params.py::get_runtime_token 經
#     $CREDENTIALS_DIRECTORY/trustforge-<name> 讀取（優先，fallback SSM）。
#   - unit 注入行：由 src/trustforge/ssm_params.py::
#     runtime_token_load_credential_line 產生，形如
#       LoadCredential=trustforge-admin-token:/run/trustforge-credentials/trustforge-admin-token
#
# 安全邊界（與 setup_runtime_credentials.sh 共用）：
#   - 未設 TRUSTFORGE_TOKEN_SSM_PREFIX → setup 腳本 no-op 退出，不建任何憑證檔
#     （離線 demo 不依賴 AWS）；本 unit 仍會跑但無副作用。
#   - token 全程不落持久磁碟（/run 即 tmpfs）、不進 argv / process list。
#   - RemainAfterExit=yes：oneshot 成功後維持 active，重啟 trustforge.service
#     不會重複觸發（除非本 unit 本身被 restart）。
# ============================================================================
[Unit]
Description=TrustForge runtime credential materialization (tmpfs)
Before=trustforge.service
DefaultDependencies=no
ConditionPathExists=/opt/trustforge/deploy/setup_runtime_credentials.sh

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CRED_DIR=/run/trustforge-credentials
ExecStart=/opt/trustforge/deploy/setup_runtime_credentials.sh

[Install]
WantedBy=multi-user.target
