{
  "version": "v1",
  "hooks": [
    {
      "name": "Run Tests Before Task Complete",
      "trigger": "PostTaskExec",
      "description": "任務完成前自動跑測試，確保程式碼品質。",
      "action": {
        "type": "command",
        "command": ".venv/bin/pytest tests/ -x -q --no-cov --timeout=60 2>&1 | tail -20",
        "timeout": 120
      }
    }
  ]
}
