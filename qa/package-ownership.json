    {"owner": "core", "priority": 90, "glob": "src/trustforge/direction_resolution.py"},
    {"owner": "core", "priority": 90, "glob": "src/trustforge/semantic_direction.py"},

    {"owner": "platform", "priority": 80, "glob": "src/trustforge/__init__.py"},
