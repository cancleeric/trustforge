{
  "schema_version": 1,
  "packages": {
    "core": {"depends_on": []},
    "platform": {"depends_on": ["core"]},
    "connectors": {"depends_on": ["core", "platform"]},
    "agent": {"depends_on": ["core", "platform", "connectors"]},
    "web": {"depends_on": ["core", "platform", "connectors", "agent"]},
    "frontend": {"depends_on": ["web"]},
    "native": {"depends_on": []}
  },
  "inventory_globs": [
    "src/**/*.py",
    "tests/**/test_*.py",
    "frontend/**",
    "native/**"
  ],
  "global_trigger_globs": [
    ".githooks/**",
    ".github/**",
    "agentcore/**",
    "app/**",
    "data/**",
    "deploy/**",
    "qa/**",
    "scripts/**",
    "tools/**",
    "tests/**",
    ".dockerignore",
    ".gitignore",
    ".nvmrc",
    "Dockerfile",
    "apprunner.yaml",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/vite.config.*",
    "frontend/tsconfig*.json",
    "native/**/Cargo.toml",
    "native/**/Cargo.lock",
    "pyproject.toml",
    "uv.lock"
  ],
  "owned_over_global_globs": [
    "tests/**/test_*.py"
  ],
  "always_run_test_globs": [
    "tests/test_architecture_import_boundaries.py",
    "tests/test_package_inventory.py",
    "tests/test_package_test_selection.py"
  ],
  "temporary_bridges": [
    {"importer": "trustforge.trust.scoring", "imported": "trustforge.bedrock", "issue": "#407"},
    {"importer": "trustforge.trust.scoring", "imported": "trustforge.ingestion.base", "issue": "#419"},
    {"importer": "trustforge.trust.scoring", "imported": "trustforge.module_telemetry", "issue": "#412"},
    {"importer": "trustforge.trust.stance_cache", "imported": "trustforge.ingestion.base", "issue": "#419"},
    {"importer": "trustforge.trust.insights", "imported": "trustforge.ingestion.base", "issue": "#419"},
    {"importer": "trustforge.trust.insights", "imported": "trustforge.schema", "issue": "#420"},
    {"importer": "trustforge.ports", "imported": "trustforge.bedrock", "issue": "#407"},
    {"importer": "trustforge.ports", "imported": "trustforge.ingestion.cache", "issue": "#408"}
  ],
  "explicit_ignore_globs": [
    ".eye-cache/**",
    ".kiro/**",
    ".venv",
    ".venv/**",
    "archive/**",
    "demo/**",
    "docs/**",
    "skills/**",
    "\"docs/**",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "ROADMAP.md",
    "llms.txt",
    "opencode.json",
    "outputs/**"
  ],
  "rules": [
