{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustforge.local/schemas/acceptance-case.schema.json",
  "title": "TrustForge acceptance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "requirement_id", "release_id", "hard", "status", "started_at", "finished_at", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^(DG|CA|UI|LOAD)-[0-9]{2}(\\[[^\\]]+\\])?$"},
    "requirement_id": {"type": "string", "pattern": "^(DG|CA|UI|LOAD)-[0-9]{2}$"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "hard": {"type": "boolean"},
    "status": {"enum": ["pass", "fail", "skipped", "not_run"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "message": {"type": "string", "maxLength": 4096},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "magic": {"type": "string", "maxLength": 64}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}
    }
  }
}
