#!/usr/bin/env bash
# TrustForge mandatory pre-push quality gate. GitHub Actions are not used;
# production deployment is a separate controlled local release operation.
# 啟用：git config core.hooksPath .githooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

PYTHON="python3"
if [ -x .venv/bin/python ]; then PYTHON=.venv/bin/python; fi
echo "[pre-push] pytest interpreter: ${PYTHON}"
run_gate() {
  label="$1"
  shift
  echo "[pre-push] running: $label"
  if ! "$@"; then
    echo "[pre-push] FAILED: $label"
    exit 1
  fi
}

run_gate "backend tests" env PYTHONPATH=src "$PYTHON" -m pytest -q
run_gate "data contracts" "$PYTHON" scripts/check_data_contracts.py
run_gate "source stub scan" "$PYTHON" scripts/scan_source_stubs.py --out out/pre-push/stub-scan.json
run_gate "competition QA" env TRUSTFORGE_BEDROCK_DAILY_USD_CAP=0 "$PYTHON" scripts/run_question_bank.py --limit 24 --out out/pre-push/question-bank-results.json
if [ ! -x frontend/node_modules/.bin/vitest ]; then
  run_gate "frontend dependencies" npm --prefix frontend ci
fi
run_gate "frontend tests" npm --prefix frontend test -- --run
run_gate "frontend lint" npm --prefix frontend run lint
run_gate "frontend build" npm --prefix frontend run build
run_gate "diff check" git diff --check

echo "[pre-push] all local quality gates passed"

echo "[pre-push] production deploy requires the controlled local release/deploy runbook"
exit 0
