#!/usr/bin/env bash
# TrustForge mandatory local pre-push quality gate. GitHub Actions are disabled.
# Production deployment is a separate controlled local release process.
# 啟用：git config core.hooksPath .githooks
# 略過部署：TRUSTFORGE_NO_CD=1 git push
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

PYTHON="python3"
if [ -x .venv/bin/python ]; then PYTHON=.venv/bin/python; fi
echo "[pre-push] pytest interpreter: ${PYTHON}"
run_gate() {
  label="$1"
  shift
  echo "[pre-push] running: $label"
  if ! "$@"; then
    echo "[pre-push] FAILED: $label"
    exit 1
  fi
}

# Node version gate (issue #660): Vite 8 bundled rolldown needs util.styleText (Node >=20.12).
NODE_MIN_MAJOR=20
NODE_MIN_MINOR=12
if [ -n "${NVM_DIR:-}" ] && [ -s "${NVM_DIR}/nvm.sh" ] && [ -f .nvmrc ]; then
  . "${NVM_DIR}/nvm.sh" >/dev/null 2>&1
  nvm use >/dev/null 2>&1 || true
fi
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] FAILED: node not found on PATH. The frontend gate needs Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR}; activate it (e.g. \`nvm install && nvm use\` per .nvmrc) and retry." >&2
  exit 1
fi
NODE_VERSION="$(node --version)"
NODE_VERSION="${NODE_VERSION#v}"
if ! [[ "$NODE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  echo "[pre-push] FAILED: cannot parse \`node --version\` ('$NODE_VERSION'); need Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR}." >&2
  exit 1
fi
NODE_MAJOR="${NODE_VERSION%%.*}"
NODE_MINOR_REST="${NODE_VERSION#*.}"
NODE_MINOR="${NODE_MINOR_REST%%.*}"
if [ "$NODE_MAJOR" -lt "$NODE_MIN_MAJOR" ] || { [ "$NODE_MAJOR" -eq "$NODE_MIN_MAJOR" ] && [ "$NODE_MINOR" -lt "$NODE_MIN_MINOR" ]; }; then
  echo "[pre-push] FAILED: Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR} required for the frontend gate (got $(node --version)). Activate it (e.g. \`nvm install && nvm use\` per .nvmrc, or otherwise put Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR} on PATH) and retry." >&2
  exit 1
fi

run_gate "backend tests" env PYTHONPATH=src "$PYTHON" -m pytest --cov-fail-under=75 -q -n auto
run_gate "data contracts" "$PYTHON" scripts/check_data_contracts.py
run_gate "source stub scan" "$PYTHON" scripts/scan_source_stubs.py --out out/pre-push/stub-scan.json
run_gate "competition QA" env TRUSTFORGE_BEDROCK_DAILY_USD_CAP=0 "$PYTHON" scripts/run_question_bank.py --limit 24 --out out/pre-push/question-bank-results.json
if [ ! -x frontend/node_modules/.bin/vitest ]; then
  run_gate "frontend dependencies" npm --prefix frontend ci
fi
run_gate "frontend tests" npm --prefix frontend test -- --run
run_gate "frontend lint" npm --prefix frontend run lint
run_gate "frontend build" npm --prefix frontend run build
run_gate "diff check" git diff --check

echo "[pre-push] all local quality gates passed"

echo "[pre-push] production deployment uses the controlled local release process"
exit 0
