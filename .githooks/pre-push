#!/usr/bin/env bash
# TrustForge mandatory local pre-push quality gate. GitHub Actions are disabled.
# Production deployment is a separate controlled local release process.
# 啟用：git config core.hooksPath .githooks
# 略過部署：TRUSTFORGE_NO_CD=1 git push
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -x .venv/bin/python ] || ! .venv/bin/python -c 'import coverage, xdist' >/dev/null 2>&1; then
  if [ ! -f uv.lock ]; then
    echo "[pre-push] FAILED: dev venv is missing/incomplete and uv.lock is unavailable." >&2
    exit 1
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo "[pre-push] FAILED: dev venv is missing/incomplete and uv is not on PATH." >&2
    exit 1
  fi
  echo "[pre-push] bootstrapping frozen dev venv from uv.lock"
  UV_CACHE_DIR="${TRUSTFORGE_UV_CACHE_DIR:-${TMPDIR:-/tmp}/trustforge-uv-cache-${UID:-$(id -u)}}"
  if ! mkdir -p "$UV_CACHE_DIR"; then
    echo "[pre-push] FAILED: cannot create sandbox-safe uv cache" >&2
    exit 1
  fi
  UV_PYTHON="${TRUSTFORGE_UV_PYTHON:-}"
  if [ -z "$UV_PYTHON" ]; then
    for python_name in python3.14 python3.13 python3.12 python3.11 python3; do
      candidate="$(command -v "$python_name" 2>/dev/null || true)"
      case "$candidate" in
        ""|/Users/*) continue ;;
      esac
      if "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
        UV_PYTHON="$candidate"
        break
      fi
    done
  fi
  if [ -z "$UV_PYTHON" ] || [ ! -x "$UV_PYTHON" ]; then
    echo "[pre-push] FAILED: sandbox-safe system Python is unavailable" >&2
    exit 1
  fi
  if ! UV_CACHE_DIR="$UV_CACHE_DIR" UV_PYTHON="$UV_PYTHON" \
    UV_PYTHON_DOWNLOADS=never uv sync --frozen --extra dev; then
    echo "[pre-push] FAILED: frozen dev venv bootstrap"
    exit 1
  fi
fi
PYTHON=.venv/bin/python
echo "[pre-push] pytest interpreter: ${PYTHON}"
run_gate() {
  label="$1"
  shift
  echo "[pre-push] running: $label"
  if ! "$@"; then
    echo "[pre-push] FAILED: $label"
    exit 1
  fi
}

# Node version gate (issue #660): Vite 8 bundled rolldown needs util.styleText (Node >=20.12).
NODE_MIN_MAJOR=20
NODE_MIN_MINOR=12
if [ -n "${NVM_DIR:-}" ] && [ -s "${NVM_DIR}/nvm.sh" ] && [ -f .nvmrc ]; then
  . "${NVM_DIR}/nvm.sh" >/dev/null 2>&1
  nvm use >/dev/null 2>&1 || true
fi
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] FAILED: node not found on PATH. The frontend gate needs Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR}; activate it (e.g. \`nvm install && nvm use\` per .nvmrc) and retry." >&2
  exit 1
fi
NODE_VERSION="$(node --version)"
NODE_VERSION="${NODE_VERSION#v}"
if ! [[ "$NODE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  echo "[pre-push] FAILED: cannot parse \`node --version\` ('$NODE_VERSION'); need Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR}." >&2
  exit 1
fi
NODE_MAJOR="${NODE_VERSION%%.*}"
NODE_MINOR_REST="${NODE_VERSION#*.}"
NODE_MINOR="${NODE_MINOR_REST%%.*}"
if [ "$NODE_MAJOR" -lt "$NODE_MIN_MAJOR" ] || { [ "$NODE_MAJOR" -eq "$NODE_MIN_MAJOR" ] && [ "$NODE_MINOR" -lt "$NODE_MIN_MINOR" ]; }; then
  echo "[pre-push] FAILED: Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR} required for the frontend gate (got $(node --version)). Activate it (e.g. \`nvm install && nvm use\` per .nvmrc, or otherwise put Node >=${NODE_MIN_MAJOR}.${NODE_MIN_MINOR} on PATH) and retry." >&2
  exit 1
fi

PYTEST_WORKERS="${TRUSTFORGE_PYTEST_WORKERS:-4}"
run_gate "backend coverage reset" "$PYTHON" -m coverage erase
case "$PYTEST_WORKERS" in
  0)
    echo "[pre-push] pytest workers: 0 (serial fallback)"
    run_gate \
      "backend tests (serial fallback)" \
      env PYTHONPATH=src "$PYTHON" -m pytest --cov-fail-under=75 -q
    ;;
  ''|*[!0-9]*)
    echo "[pre-push] FAILED: TRUSTFORGE_PYTEST_WORKERS must be a non-negative integer (got '$PYTEST_WORKERS')." >&2
    exit 1
    ;;
  *)
    echo "[pre-push] pytest workers: ${PYTEST_WORKERS} (fixed, worksteal)"
    run_gate \
      "backend tests (parallel lane)" \
      env PYTHONPATH=src "$PYTHON" -m pytest -q \
        -m "not serial" -n "$PYTEST_WORKERS" --dist worksteal \
        --cov-report= --cov-fail-under=0
    run_gate \
      "backend tests (serial lane)" \
      env PYTHONPATH=src "$PYTHON" -m pytest -q \
        -m "serial" -n 0 --cov-append --cov-report= --cov-fail-under=0
    run_gate \
      "backend coverage" \
      "$PYTHON" -m coverage report --show-missing --fail-under=75
    ;;
esac
run_gate "data contracts" "$PYTHON" scripts/check_data_contracts.py
run_gate "YAML duplicate keys" "$PYTHON" scripts/check_yaml_duplicate_keys.py
run_gate "source stub scan" "$PYTHON" scripts/scan_source_stubs.py --out out/pre-push/stub-scan.json
run_gate \
  "NF2 zero-capability host tests" \
  env CARGO_TARGET_DIR=out/nf2-cargo-target \
    cargo test --manifest-path native/nf2-zero-capability-broker/Cargo.toml --locked
run_gate \
  "NF2 zero-capability x86_64-musl clippy" \
  env CARGO_TARGET_DIR=out/nf2-cargo-target \
    cargo clippy --manifest-path native/nf2-zero-capability-broker/Cargo.toml \
    --target x86_64-unknown-linux-musl --all-targets -- -D warnings
run_gate \
  "NF2 adversarial-hook x86_64-musl compile and clippy" \
  env CARGO_TARGET_DIR=out/nf2-cargo-target \
    cargo clippy --manifest-path native/nf2-zero-capability-broker/Cargo.toml \
    --target x86_64-unknown-linux-musl --all-targets \
    --features adversarial-test-hooks -- -D warnings
run_gate \
  "NF2 adversarial-hook Linux tests compile" \
  env CARGO_TARGET_DIR=out/nf2-cargo-target \
    cargo check --manifest-path native/nf2-zero-capability-broker/Cargo.toml \
    --target x86_64-unknown-linux-musl --all-targets \
    --features adversarial-test-hooks --locked
run_gate \
  "NF2 release rejects adversarial hooks" \
  bash -ceu 'log=out/nf2-release-hooks-rejection.log
    if env CARGO_TARGET_DIR=out/nf2-cargo-target cargo check \
      --manifest-path native/nf2-zero-capability-broker/Cargo.toml \
      --release --target x86_64-unknown-linux-musl \
      --features adversarial-test-hooks >"$log" 2>&1; then
      echo "release unexpectedly accepted adversarial hooks" >&2
      exit 1
    fi
    grep -q "structurally forbidden in release builds" "$log"'
run_gate \
  "NF2 Linux harness syntax" \
  "$PYTHON" -m py_compile scripts/test_nf2_zero_capability_linux.py
run_gate \
  "NF3 retained-dirfd host tests" \
  env CARGO_TARGET_DIR=out/nf3-cargo-target \
    cargo test --manifest-path native/nf3-one-shot-transaction/Cargo.toml --locked
run_gate \
  "NF3 retained-dirfd x86_64-musl clippy" \
  env CARGO_TARGET_DIR=out/nf3-cargo-target \
    cargo clippy --manifest-path native/nf3-one-shot-transaction/Cargo.toml \
    --target x86_64-unknown-linux-musl --all-targets --locked -- -D warnings
run_gate "competition QA" env TRUSTFORGE_BEDROCK_DAILY_USD_CAP=0 "$PYTHON" scripts/run_question_bank.py --limit 24 --out out/pre-push/question-bank-results.json
if [ ! -x frontend/node_modules/.bin/vitest ]; then
  # The caller may export NODE_ENV=production (for example, OpenClaw and
  # release shells do). npm then omits devDependencies by default, leaving the
  # freshly-installed tree without vitest, oxlint, TypeScript, or Vite. The
  # quality gate requires those tools regardless of the caller environment.
  run_gate "frontend dependencies" npm --prefix frontend ci --include=dev
fi
run_gate "frontend tests" npm --prefix frontend test -- --run
run_gate "frontend lint" npm --prefix frontend run lint
run_gate "frontend build" npm --prefix frontend run build
run_gate "diff check" git diff --check
if [ -n "${TRUSTFORGE_RELEASE_BASE_REF:-}" ]; then
  if ! git rev-parse --verify "${TRUSTFORGE_RELEASE_BASE_REF}^{commit}" >/dev/null 2>&1; then
    echo "[pre-push] FAILED: release base ref is not a local commit: ${TRUSTFORGE_RELEASE_BASE_REF}" >&2
    exit 1
  fi
  run_gate \
    "release range diff check (${TRUSTFORGE_RELEASE_BASE_REF}..HEAD)" \
    git diff --check "${TRUSTFORGE_RELEASE_BASE_REF}..HEAD"
fi

echo "[pre-push] all local quality gates passed"

echo "[pre-push] production deployment uses the controlled local release process"
exit 0
