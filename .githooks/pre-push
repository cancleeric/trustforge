#!/usr/bin/env bash
# TrustForge pre-push：只做本地品質閘；production CD 只由受保護 release tag
# 的 GitHub Actions workflow 觸發，不能因任意開發分支 push 自動部署。
# 啟用：git config core.hooksPath .githooks
# 略過部署：TRUSTFORGE_NO_CD=1 git push
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

PYTHON="python3"
if [ -x .venv/bin/python ]; then PYTHON=.venv/bin/python; fi
echo "[pre-push] pytest interpreter: ${PYTHON}"
if ! PYTHONPATH=src "$PYTHON" -m pytest -q; then
  echo "[pre-push] ❌ 測試未過 → 阻擋 push（修綠再推）"
  exit 1
fi
echo "[pre-push] ✅ 測試綠"

echo "[pre-push] release CD 由 GitHub production workflow 處理"
exit 0
